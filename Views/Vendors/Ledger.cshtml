@using INSolPOS.Models
@model List<VendorLedger>
@{
    ViewBag.Title = "Vendor Ledger";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var vendor  = ViewBag.Vendor  as Vendor;
    var balance = (decimal)(ViewBag.Balance ?? 0m);
}

<div class="flex justify-between items-center mb-4 no-print">
    <a href="/Vendors/Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
    <div class="flex gap-2">
        <form method="get" class="flex gap-2 items-center">
            <input type="hidden" name="id" value="@vendor?.Id" />
            <input type="date" name="from" value="@ViewBag.From?.ToString("yyyy-MM-dd")" class="form-control" style="width:148px;" />
            <span class="text-muted">—</span>
            <input type="date" name="to"   value="@ViewBag.To?.ToString("yyyy-MM-dd")"   class="form-control" style="width:148px;" />
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i></button>
        </form>
        <button onclick="window.print()" class="btn btn-secondary btn-sm"><i class="fas fa-print"></i> Print</button>
        <button onclick="document.getElementById('payModal').classList.add('open')" class="btn btn-success btn-sm">
            <i class="fas fa-money-bill-wave"></i> Pay Vendor
        </button>
    </div>
</div>

<!-- Vendor Info -->
<div class="card mb-4">
    <div class="card-body" style="padding:16px 20px;">
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;align-items:center;">
            <div>
                <div class="text-xs text-muted mb-1">VENDOR</div>
                <div class="fw-bold" style="font-size:16px;">@vendor?.Name</div>
                <div class="text-muted text-sm">@(vendor?.CompanyName ?? "—")</div>
            </div>
            <div><div class="text-xs text-muted mb-1">PHONE</div><div class="font-mono">@(vendor?.Phone ?? "—")</div></div>
            <div><div class="text-xs text-muted mb-1">CNIC</div><div class="font-mono text-sm">@(vendor?.CNIC ?? "—")</div></div>
            <div>
                <div class="text-xs text-muted mb-1">PAYABLE BALANCE</div>
                <div class="font-mono fw-bold @(balance > 0 ? "text-red" : "text-green")" style="font-size:18px;">
                    Rs. @Math.Abs(balance).ToString("N2")
                </div>
                <div class="text-xs @(balance > 0 ? "text-red" : balance < 0 ? "text-green" : "text-muted")">
                    @(balance > 0 ? "We Owe Vendor" : balance < 0 ? "Vendor Owes Us" : "Settled")
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ledger Table -->
<div class="card">
    <div class="card-header">
        <span class="card-title"><i class="fas fa-book text-accent" style="margin-right:8px;"></i>Vendor Account Ledger</span>
        <span class="badge badge-info">@Model.Count entries</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Type</th>
                    <th class="text-right">Debit (Payment)</th>
                    <th class="text-right">Credit (Purchase)</th>
                    <th class="text-right">Balance</th>
                </tr>
            </thead>
            <tbody>
                @{ int row = 1; }
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="text-muted text-xs">@(row++)</td>
                        <td class="font-mono text-muted text-sm">@e.Date.ToString("dd MMM yy HH:mm")</td>
                        <td>@e.Description</td>
                        <td>
                            @switch (e.ReferenceType)
                            {
                                case "Purchase":       <span class="badge badge-warning">Purchase</span>       break;
                                case "Payment":        <span class="badge badge-success">Payment</span>        break;
                                case "PurchaseReturn": <span class="badge badge-info">Return</span>            break;
                                case "Opening":        <span class="badge badge-accent">Opening</span>         break;
                                default:               <span class="badge">@e.ReferenceType</span>             break;
                            }
                        </td>
                        <td class="text-right font-mono @(e.Debit > 0 ? "text-green" : "text-muted")">
                            @(e.Debit > 0 ? "Rs. " + e.Debit.ToString("N2") : "—")
                        </td>
                        <td class="text-right font-mono @(e.Credit > 0 ? "text-red" : "text-muted")">
                            @(e.Credit > 0 ? "Rs. " + e.Credit.ToString("N2") : "—")
                        </td>
                        <td class="text-right font-mono fw-semibold @(e.Balance > 0 ? "text-amber" : e.Balance < 0 ? "text-green" : "text-muted")">
                            Rs. @e.Balance.ToString("N2")
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center;padding:32px;color:var(--c-text3);">
                            <i class="fas fa-book-open" style="font-size:28px;opacity:0.3;display:block;margin-bottom:8px;"></i>
                            No ledger entries found.
                        </td>
                    </tr>
                }
            </tbody>
            @if (Model.Any())
            {
                <tfoot>
                    <tr style="background:var(--c-surface2);font-weight:700;">
                        <td colspan="4">TOTALS</td>
                        <td class="text-right font-mono text-green">Rs. @Model.Sum(e => e.Debit).ToString("N2")</td>
                        <td class="text-right font-mono text-red">Rs. @Model.Sum(e => e.Credit).ToString("N2")</td>
                        <td class="text-right font-mono @(balance > 0 ? "text-amber" : "text-green")">
                            Rs. @balance.ToString("N2")
                        </td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal-backdrop no-print" id="payModal">
    <div class="modal">
        <div class="modal-title"><i class="fas fa-money-bill-wave text-green" style="margin-right:8px;"></i>Pay Vendor — @vendor?.Name</div>
        <form method="post" action="/Vendors/AddPayment">
            <input type="hidden" name="vendorId" value="@vendor?.Id" />
            <div class="form-group mb-3">
                <label class="form-label">AMOUNT (Rs.) *</label>
                <input type="number" name="amount" class="form-control font-mono" min="0.01" step="0.01" required
                       value="@(balance > 0 ? balance.ToString("F2") : "0")" style="font-size:18px;" />
            </div>
            <div class="form-group mb-4">
                <label class="form-label">NOTES</label>
                <input type="text" name="notes" class="form-control" placeholder="Payment reference, cheque no, bank..." />
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn btn-success"><i class="fas fa-check"></i> Confirm Payment</button>
                <button type="button" class="btn btn-secondary"
                        onclick="document.getElementById('payModal').classList.remove('open')">Cancel</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('.modal-backdrop').forEach(el =>
    el.addEventListener('click', e => { if (e.target === el) el.classList.remove('open'); }));
</script>
}
