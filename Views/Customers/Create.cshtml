@using INSolPOS.Models
@model Customer
@{
    ViewBag.Title = "Register Customer";
    ViewBag.NavContext = "customers";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var routes = ViewBag.Routes as List<SaleRoute> ?? new();
}

<div class="flex gap-2 mb-4">
    <a href="/Customers/Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div class="card" style="max-width:820px;">
    <div class="card-header">
        <span class="card-title"><i class="fas fa-user-plus text-accent" style="margin-right:8px;"></i>Register New Customer</span>
    </div>
    <div class="card-body">
        <form method="post" action="/Customers/Create">
            <div class="form-grid">
                <div class="form-group" style="grid-column:span 2;">
                    <label class="form-label">FULL NAME *</label>
                    <input type="text" name="Name" class="form-control" required placeholder="Customer full name" />
                </div>
                <div class="form-group">
                    <label class="form-label">PHONE</label>
                    <input type="text" name="Phone" class="form-control font-mono" placeholder="03XX-XXXXXXX" />
                </div>
                <div class="form-group">
                    <label class="form-label">CNIC</label>
                    <input type="text" name="CNIC" class="form-control font-mono" placeholder="XXXXX-XXXXXXX-X" />
                </div>
                <div class="form-group">
                    <label class="form-label">EMAIL</label>
                    <input type="email" name="Email" class="form-control" placeholder="email@example.com" />
                </div>
                <div class="form-group">
                    <label class="form-label">SALE ROUTE / AREA</label>
                    <select name="RouteId" class="form-control">
                        <option value="">— No Route —</option>
                        @foreach (var r in routes)
                        {
                            <option value="@r.Id">@r.Name (@r.Area)</option>
                        }
                    </select>
                </div>
                <div class="form-group" style="grid-column:span 2;">
                    <label class="form-label">ADDRESS</label>
                    <textarea name="Address" class="form-control" rows="2" placeholder="Full address..."></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">CREDIT LIMIT (Rs.)</label>
                    <input type="number" name="CreditLimit" class="form-control font-mono" value="0" min="0" step="100" />
                </div>
                <div class="form-group">
                    <label class="form-label">OPENING BALANCE (Rs.)</label>
                    <input type="number" name="OpeningBalance" class="form-control font-mono" value="0" min="0" step="0.01" />
                </div>
            </div>
            <div class="flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Register Customer</button>
                <a href="/Customers/Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
