@using INSolPOS.Models
@{
    ViewBag.Title = "New Purchase";
    ViewBag.NavContext = "purchases";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var vendors = ViewBag.Vendors as List<Vendor> ?? new();
    var warehouses = ViewBag.Warehouses as List<Warehouse> ?? new();
    var products = ViewBag.Products as List<Product> ?? new();
}

<div class="flex gap-2 mb-4">
    <a href="/Purchases/Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div style="display:grid;grid-template-columns:1fr 340px;gap:20px;align-items:start;">

    <!-- LEFT: Items -->
    <div>
        <div class="card mb-4">
            <div class="card-header">
                <span class="card-title">Purchase Items</span>
                <button type="button" class="btn btn-primary btn-sm" onclick="addRow()">
                    <i class="fas fa-plus"></i> Add Product Row
                </button>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th style="min-width:180px;">Product</th>
                            <th style="width:80px;">Cartons</th>
                            <th style="width:80px;">Loose</th>
                            <th style="width:110px;">Price/Unit</th>
                            <th style="width:90px;">Batch</th>
                            <th style="width:120px;">Expiry</th>
                            <th class="text-right" style="width:90px;">Amount</th>
                            <th style="width:36px;"></th>
                        </tr>
                    </thead>
                    <tbody id="itemRows">
                        <tr id="emptyRow">
                            <td colspan="8" style="text-align:center;padding:40px;color:var(--c-text3);">
                                <i class="fas fa-plus-circle" style="font-size:32px;opacity:0.3;display:block;margin-bottom:8px;"></i>
                                Click "Add Product Row" to add products
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- RIGHT: Details -->
    <div style="position:sticky;top:80px;">
        <div class="card">
            <div class="card-header"><span class="card-title">Purchase Details</span></div>
            <div class="card-body">
                <form method="post" action="/Purchases/Create" id="purchForm">
                    <div class="form-group mb-3">
                        <label class="form-label">VENDOR *</label>
                        <select name="VendorId" class="form-control" required>
                            <option value="">Select vendor...</option>
                            @foreach (var v in vendors)
                            {
                                <option value="@v.Id">@v.Name@(v.CompanyName != null ? " — " + v.CompanyName : "")</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">PURCHASE DATE</label>
                        <input type="datetime-local" name="PurchaseDate" class="form-control"
                               value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">PAYMENT METHOD</label>
                        <select name="PaymentMethod" class="form-control">
                            <option value="1">Cash</option>
                            <option value="4">Credit / On Account</option>
                            <option value="2">Bank Transfer</option>
                            <option value="3">Cheque</option>
                        </select>
                    </div>

                    <div style="background:var(--c-surface2);border:1px solid var(--c-border);border-radius:10px;padding:14px;margin:14px 0;">
                        <div class="flex justify-between text-sm mb-2"><span class="text-muted">Sub Total</span><span class="font-mono" id="subTotalDisp">Rs. 0.00</span></div>
                        <div class="flex justify-between text-sm mb-2" style="align-items:center;">
                            <span class="text-muted">Discount</span>
                            <input type="number" name="Discount" value="0" min="0" step="0.01"
                                   class="form-control font-mono" style="width:95px;padding:4px 8px;text-align:right;" oninput="calcTotal()" />
                        </div>
                        <div class="flex justify-between text-sm mb-2" style="align-items:center;">
                            <span class="text-muted">Tax</span>
                            <input type="number" name="Tax" value="0" min="0" step="0.01"
                                   class="form-control font-mono" style="width:95px;padding:4px 8px;text-align:right;" oninput="calcTotal()" />
                        </div>
                        <div class="flex justify-between" style="border-top:1px solid var(--c-border);padding-top:10px;margin-top:6px;">
                            <span class="fw-bold">TOTAL</span>
                            <span class="font-mono fw-bold text-accent" style="font-size:18px;" id="totalDisp">Rs. 0.00</span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">PAID AMOUNT</label>
                        <input type="number" name="PaidAmount" id="paidAmt" class="form-control font-mono" value="0" min="0" step="0.01" />
                    </div>
                    <div class="form-group mb-4">
                        <label class="form-label">NOTES</label>
                        <textarea name="Notes" class="form-control" rows="2" placeholder="Optional..."></textarea>
                    </div>

                    <div id="hiddenInputs"></div>
                    <input type="hidden" name="SubTotal" id="subTotalHidden" value="0" />

                    <button type="submit" class="btn btn-primary w-full" style="justify-content:center;font-size:14px;padding:12px;">
                        <i class="fas fa-save"></i> Save Purchase
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const PRODUCTS = @Html.Raw(JsonSerializer.Serialize(products.Select(p => new
            {
                id = p.Id,
                name = p.Name,
                purchasePrice = p.PurchasePrice,
                cartonQty = p.CartonQty,
                batchNo = p.BatchNo ?? "",
                expiryDate = p.ExpiryDate.HasValue ? p.ExpiryDate.Value.ToString("yyyy-MM-dd") : "",
                currentStock = p.CurrentStock,
                unitName = p.Unit != null ? p.Unit.Abbreviation : "Pcs"
            })));

        let rowCount = 0;

        function addRow() {
            document.getElementById('emptyRow')?.remove();
            rowCount++;
            const id = rowCount;
            const opts = PRODUCTS.map(p =>
                `<option value="${p.id}" data-price="${p.purchasePrice}" data-carton="${p.cartonQty}"
                         data-batch="${p.batchNo}" data-expiry="${p.expiryDate}"
                         data-stock="${p.currentStock}">${p.name}</option>`
            ).join('');

            const tr = document.createElement('tr');
            tr.id = 'row_' + id;
            tr.innerHTML = `
                <td>
                    <select name="productIds" class="form-control" style="min-width:160px;font-size:12px;"
                            onchange="onProductChange(this, ${id})">
                        <option value="">Select product...</option>
                        ${opts}
                    </select>
                </td>
                <td><input type="number" name="cartonQtys" value="0" min="0" step="0.5"
                    class="form-control font-mono" style="width:72px;font-size:12px;"
                    oninput="calcRow(${id})" id="carton_${id}" /></td>
                <td><input type="number" name="looseQtys" value="0" min="0" step="0.5"
                    class="form-control font-mono" style="width:72px;font-size:12px;"
                    oninput="calcRow(${id})" id="loose_${id}" /></td>
                <td><input type="number" name="prices" value="0" min="0" step="0.01"
                    class="form-control font-mono" style="width:100px;font-size:12px;"
                    oninput="calcRow(${id})" id="price_${id}" /></td>
                <td><input type="text" name="batchNos" placeholder="Batch#"
                    class="form-control" style="width:82px;font-size:12px;" id="batch_${id}" /></td>
                <td><input type="date" name="expiryDates"
                    class="form-control" style="width:115px;font-size:12px;" id="expiry_${id}" /></td>
                <td class="font-mono fw-semibold text-accent text-right" id="amt_${id}">0.00</td>
                <td><button type="button" onclick="removeRow(${id})" class="btn btn-danger btn-xs btn-icon">
                    <i class="fas fa-times"></i></button></td>
            `;
            document.getElementById('itemRows').appendChild(tr);
            // Focus the select
            tr.querySelector('select').focus();
            calcTotal();
        }

        document.getElementById('purchForm').addEventListener('submit', function(e) {
            const selects = document.querySelectorAll('#itemRows select[name="productIds"]');
            if (!selects.length || selects[0].id === 'emptyRow') {
                e.preventDefault();
                alert('Please add at least one product row.');
                return;
            }
            let hasProduct = false;
            selects.forEach(s => { if (s.value) hasProduct = true; });
            if (!hasProduct) {
                e.preventDefault();
                alert('Please select a product in each row.');
            }
        });

        function removeRow(id) {
            document.getElementById('row_' + id)?.remove();
            if (!document.getElementById('itemRows').querySelector('tr')) {
                const tbody = document.getElementById('itemRows');
                tbody.innerHTML = `<tr id="emptyRow"><td colspan="8" style="text-align:center;padding:40px;color:var(--c-text3);">
                    <i class="fas fa-plus-circle" style="font-size:32px;opacity:0.3;display:block;margin-bottom:8px;"></i>
                    Click "Add Product Row" to add products</td></tr>`;
            }
            calcTotal();
        }

        function onProductChange(sel, rowId) {
            const opt = sel.options[sel.selectedIndex];
            if (!opt.value) return;
            document.getElementById('price_'  + rowId).value = opt.dataset.price   || 0;
            document.getElementById('batch_'  + rowId).value = opt.dataset.batch   || '';
            document.getElementById('expiry_' + rowId).value = opt.dataset.expiry  || '';
            calcRow(rowId);
        }

        function calcRow(rowId) {
            const carton = parseFloat(document.getElementById('carton_' + rowId)?.value) || 0;
            const loose  = parseFloat(document.getElementById('loose_'  + rowId)?.value) || 0;
            const price  = parseFloat(document.getElementById('price_'  + rowId)?.value) || 0;
            const sel    = document.querySelector(`#row_${rowId} select[name="productIds"]`);
            const cartonSize = parseInt(sel?.options[sel.selectedIndex]?.dataset.carton || 1);
            const totalQty   = (carton * cartonSize) + loose;
            const amt        = totalQty * price;
            const el = document.getElementById('amt_' + rowId);
            if (el) el.textContent = amt.toFixed(2);
            calcTotal();
        }

        function calcTotal() {
            let sub = 0;
            document.querySelectorAll('[id^="amt_"]').forEach(el => sub += parseFloat(el.textContent) || 0);
            const disc = parseFloat(document.querySelector('[name="Discount"]')?.value) || 0;
            const tax  = parseFloat(document.querySelector('[name="Tax"]')?.value) || 0;
            const tot  = sub + tax - disc;
            document.getElementById('subTotalDisp').textContent = 'Rs. ' + sub.toFixed(2);
            document.getElementById('totalDisp').textContent    = 'Rs. ' + tot.toFixed(2);
            document.getElementById('subTotalHidden').value     = sub.toFixed(2);
            document.getElementById('paidAmt').value            = tot.toFixed(2);
        }
    </script>
}
