@using INSolPOS.Models
@model PurchaseReturn
@{
    ViewBag.Title = "Purchase Return";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var purchase = ViewBag.Purchase as Purchase;
}
<div class="flex gap-2 mb-4">
    <a href="/Purchases/Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
</div>
<div class="card" style="max-width:800px;">
    <div class="card-header">
        <span class="card-title"><i class="fas fa-undo text-amber" style="margin-right:8px;"></i>Purchase Return — @purchase?.InvoiceNo</span>
        <span class="badge badge-info">@purchase?.PurchaseDate.ToString("dd MMM yyyy")</span>
    </div>
    <div class="card-body">
        <form method="post" action="/Purchases/Return">
            <input type="hidden" name="PurchaseId" value="@purchase?.Id" />
            <div class="form-group mb-4">
                <label class="form-label">REASON FOR RETURN *</label>
                <textarea name="Reason" class="form-control" required placeholder="Describe reason..."></textarea>
            </div>
            <div class="table-wrap mb-4">
                <table>
                    <thead><tr><th>Product</th><th class="text-right">Purchased Qty</th><th class="text-right">Price</th><th class="text-right">Return Qty</th></tr></thead>
                    <tbody>
                        @foreach (var item in purchase?.Items ?? new())
                        {
                            <tr>
                                <input type="hidden" name="productIds" value="@item.ProductId" />
                                <input type="hidden" name="prices" value="@item.PurchasePrice" />
                                <td class="fw-semibold">@item.Product?.Name</td>
                                <td class="text-right font-mono">@item.TotalQty</td>
                                <td class="text-right font-mono">@item.PurchasePrice.ToString("N2")</td>
                                <td class="text-right">
                                    <input type="number" name="quantities" value="0" min="0" max="@item.TotalQty" step="0.5"
                                        class="form-control font-mono" style="width:90px;text-align:right;display:inline-block;" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn btn-warning"><i class="fas fa-undo"></i> Process Return</button>
                <a href="/Purchases/Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
