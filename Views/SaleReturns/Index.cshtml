@using INSolPOS.Models
@model List<SaleReturn>
@{
    ViewBag.Title = "Sale Returns";
    ViewBag.NavContext = "sale-returns";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex justify-between items-center mb-4">
    <div style="font-size:13px;color:var(--c-text3);">@Model.Count return(s) on record</div>
    <a href="/SaleReturns/Create" class="btn btn-warning"><i class="fas fa-undo"></i> New Sale Return</a>
</div>

<div class="stat-grid" style="grid-template-columns:repeat(3,1fr);margin-bottom:16px;">
    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-label">Total Returns</span>
            <div class="stat-icon" style="background:rgba(245,158,11,0.12);color:var(--c-amber);"><i class="fas fa-undo"></i></div>
        </div>
        <div class="stat-value font-mono text-amber" style="font-size:22px;">@Model.Count</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-label">Total Return Value</span>
            <div class="stat-icon" style="background:rgba(239,68,68,0.12);color:var(--c-red);"><i class="fas fa-coins"></i></div>
        </div>
        <div class="stat-value font-mono text-red" style="font-size:20px;">Rs. @Model.Sum(r => r.TotalAmount).ToString("N0")</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-label">This Month</span>
            <div class="stat-icon" style="background:rgba(79,110,247,0.12);color:var(--c-accent);"><i class="fas fa-calendar"></i></div>
        </div>
        <div class="stat-value font-mono text-accent" style="font-size:20px;">
            Rs. @Model.Where(r => r.ReturnDate.Month == DateTime.Now.Month && r.ReturnDate.Year == DateTime.Now.Year).Sum(r => r.TotalAmount).ToString("N0")
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <span class="card-title"><i class="fas fa-undo text-amber" style="margin-right:8px;"></i>Sale Return History</span>
        <input type="text" id="searchBox" placeholder="Search..." class="form-control" style="width:180px;" oninput="filterTable()" />
    </div>
    <div class="table-wrap">
        <table id="retTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Return Date</th>
                    <th>Sale Invoice</th>
                    <th>Customer</th>
                    <th>Items Returned</th>
                    <th class="text-right">Return Value</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                @{ int row = 1; }
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="text-muted text-xs">@(row++)</td>
                        <td class="font-mono text-muted text-sm">@r.ReturnDate.ToString("dd MMM yy HH:mm")</td>
                        <td class="font-mono text-accent">@(r.Sale?.InvoiceNo ?? "—")</td>
                        <td class="fw-semibold">@(r.Sale?.Customer?.Name ?? "Walk-in")</td>
                        <td>
                            @foreach (var item in r.Items.Take(2))
                            {
                                <div class="text-sm">@item.Product?.Name <span class="text-muted">(×@item.Quantity)</span></div>
                            }
                            @if (r.Items.Count > 2)
                            { <div class="text-xs text-muted">+@(r.Items.Count - 2) more item(s)</div> }
                        </td>
                        <td class="text-right font-mono fw-bold text-red">Rs. @r.TotalAmount.ToString("N2")</td>
                        <td class="text-muted text-sm">@(r.Reason ?? "—")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center;padding:40px;color:var(--c-text3);">
                            <i class="fas fa-undo" style="font-size:32px;opacity:0.3;display:block;margin-bottom:10px;"></i>
                            No sale returns on record.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
function filterTable() {
    const q = document.getElementById('searchBox').value.toLowerCase();
    document.querySelectorAll('#retTable tbody tr').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
}
</script>
}
