@using INSolPOS.Models
@model Staff
@{
    ViewBag.Title = "Edit Staff";
    ViewBag.NavContext = "staff";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="flex gap-2 mb-4">
    <a href="/Staff/Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
</div>
<div class="card" style="max-width:700px;">
    <div class="card-header"><span class="card-title"><i class="fas fa-edit text-accent" style="margin-right:8px;"></i>Edit Staff Member</span></div>
    <div class="card-body">
        <form method="post" action="/Staff/Edit">
            <input type="hidden" name="Id" value="@Model?.Id" />
            <div class="form-grid">
                <div class="form-group" style="grid-column:span 2;"><label class="form-label">FULL NAME *</label><input type="text" name="Name" class="form-control" value="@Model?.Name" required /></div>
                <div class="form-group">
                    <label class="form-label">DESIGNATION *</label>
                    <select name="Designation" class="form-control" required>
                        @foreach (var d in new[] { "Salesman", "Driver", "Loader", "Helper", "Cashier", "Manager", "Accountant", "Other" })
                        {
                            <option value="@d" selected="@(Model?.Designation == d)">@d</option>
                        }
                    </select>
                </div>
                <div class="form-group"><label class="form-label">PHONE</label><input type="text" name="Phone" class="form-control font-mono" value="@Model?.Phone" /></div>
                <div class="form-group"><label class="form-label">CNIC</label><input type="text" name="CNIC" class="form-control font-mono" value="@Model?.CNIC" /></div>
                <div class="form-group"><label class="form-label">BASIC SALARY *</label><input type="number" name="BasicSalary" class="form-control font-mono" value="@Model?.BasicSalary" required min="0" /></div>
                <div class="form-group" style="grid-column:span 2;"><label class="form-label">ADDRESS</label><textarea name="Address" class="form-control" rows="2">@Model?.Address</textarea></div>
            </div>
            <div class="flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Update</button>
                <a href="/Staff/Index" class="btn btn-secondary">Cancel</a>
                <a href="/Staff/Salaries/@Model?.Id" class="btn btn-success"><i class="fas fa-money-check"></i> Salary History</a>
            </div>
        </form>
    </div>
</div>
