@using INSolPOS.Models
@model List<SaleCommission>
@{
    ViewBag.Title = "Sale Commissions";
    ViewBag.NavContext = "commissions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex gap-2 mb-4">
    <a href="/Staff/Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div class="stat-grid" style="grid-template-columns:repeat(3,1fr);">
    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-label">Total Commission</span>
            <div class="stat-icon" style="background:rgba(79,110,247,0.15);color:var(--c-accent);"><i class="fas fa-percentage"></i></div>
        </div>
        <div class="stat-value font-mono text-accent">Rs. @Model.Sum(c => c.CommissionAmount).ToString("N0")</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-label">Paid Commission</span>
            <div class="stat-icon" style="background:rgba(34,197,94,0.15);color:var(--c-green);"><i class="fas fa-check-circle"></i></div>
        </div>
        <div class="stat-value font-mono text-green">Rs. @Model.Where(c => c.IsPaid).Sum(c => c.CommissionAmount).ToString("N0")</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-label">Pending Commission</span>
            <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:var(--c-amber);"><i class="fas fa-clock"></i></div>
        </div>
        <div class="stat-value font-mono text-amber">Rs. @Model.Where(c => !c.IsPaid).Sum(c => c.CommissionAmount).ToString("N0")</div>
    </div>
</div>

<div class="card">
    <div class="card-header"><span class="card-title">Commission Records</span></div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Sale Invoice</th>
                    <th>Date</th>
                    <th>Staff Member</th>
                    <th class="text-right">Commission</th>
                    <th>Status</th>
                    <th>Paid On</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="font-mono text-accent">@c.Sale?.InvoiceNo</td>
                        <td class="text-muted text-sm">@c.Sale?.SaleDate.ToString("dd MMM yy")</td>
                        <td class="fw-semibold">@c.Staff?.Name</td>
                        <td class="text-right font-mono fw-bold">Rs. @c.CommissionAmount.ToString("N2")</td>
                        <td>
                            @if (c.IsPaid)
                            { <span class="badge badge-success">Paid</span> }
                            else
                            { <span class="badge badge-warning">Pending</span> }
                        </td>
                        <td class="text-muted text-sm">@(c.PaidOn?.ToString("dd MMM yy") ?? "—")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" style="text-align:center;padding:32px;color:var(--c-text3);">No commission records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
