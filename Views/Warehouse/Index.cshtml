@using INSolPOS.Models
@model List<Warehouse>
@{
    ViewBag.Title = "Warehouses";
    ViewBag.NavContext = "warehouse";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex justify-between items-center mb-4">
    <div style="font-size:13px;color:var(--c-text3);">@Model.Count warehouse(s)</div>
    <button onclick="document.getElementById('addWH').classList.add('open')" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add Warehouse
    </button>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-error mb-4"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
}

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;">
    @foreach (var w in Model)
    {
        <div class="card">
            <div class="card-body">
                <div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;">
                    <div style="width:46px;height:46px;background:rgba(79,110,247,0.15);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--c-accent);flex-shrink:0;">
                        <i class="fas fa-warehouse"></i>
                    </div>
                    <div style="flex:1;">
                        <div class="fw-bold" style="font-size:15px;">@w.Name</div>
                        <div class="text-muted text-sm">@(w.Location ?? "No location set")</div>
                        @if (!string.IsNullOrEmpty(w.ManagerName))
                        {
                            <div style="font-size:12px;color:var(--c-text3);margin-top:2px;">
                                <i class="fas fa-user" style="margin-right:4px;"></i>@w.ManagerName
                            </div>
                        }
                    </div>
                    <!-- Edit + Delete buttons -->
                    <div class="flex gap-1">
                        <button class="btn btn-secondary btn-xs btn-icon" title="Edit Warehouse"
                                onclick="openEditWH(@w.Id, '@Html.Raw(w.Name.Replace("'","\\\'"))', '@Html.Raw((w.Location??"").Replace("'","\\\'"))', '@Html.Raw((w.ManagerName??"").Replace("'","\\\'"))')">
                            <i class="fas fa-edit"></i>
                        </button>
                        <form method="post" action="/Warehouse/Delete/@w.Id" style="display:inline;"
                              onsubmit="return confirm('Delete warehouse \'@w.Name\'?\n\nThis will deactivate the warehouse. Warehouses with stock or transaction history cannot be deleted.')">
                            <button type="submit" class="btn btn-danger btn-xs btn-icon" title="Delete Warehouse">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>

                <div class="flex gap-2">
                    <a href="/Warehouse/Stock/@w.Id" class="btn btn-secondary btn-sm" style="flex:1;justify-content:center;">
                        <i class="fas fa-boxes"></i> View Stock
                    </a>
                    <a href="/Warehouse/Transfer" class="btn btn-primary btn-sm" style="flex:1;justify-content:center;">
                        <i class="fas fa-exchange-alt"></i> Transfer
                    </a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div style="grid-column:1/-1;text-align:center;padding:60px;color:var(--c-text3);">
            <i class="fas fa-warehouse" style="font-size:48px;opacity:0.2;display:block;margin-bottom:12px;"></i>
            No warehouses registered yet. Add one to get started.
        </div>
    }
</div>

<!-- Add Warehouse Modal -->
<div class="modal-backdrop" id="addWH">
    <div class="modal">
        <div class="modal-title"><i class="fas fa-warehouse text-accent" style="margin-right:8px;"></i>Add Warehouse</div>
        <form method="post" action="/Warehouse/Create">
            <div class="form-group mb-3">
                <label class="form-label">NAME *</label>
                <input type="text" name="Name" class="form-control" required placeholder="e.g. Main Warehouse" />
            </div>
            <div class="form-group mb-3">
                <label class="form-label">LOCATION</label>
                <input type="text" name="Location" class="form-control" placeholder="e.g. Lahore - Main Branch" />
            </div>
            <div class="form-group mb-4">
                <label class="form-label">MANAGER NAME</label>
                <input type="text" name="ManagerName" class="form-control" placeholder="Optional" />
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Add Warehouse</button>
                <button type="button" class="btn btn-secondary"
                        onclick="document.getElementById('addWH').classList.remove('open')">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Warehouse Modal -->
<div class="modal-backdrop" id="editWHModal">
    <div class="modal">
        <div class="modal-title"><i class="fas fa-warehouse text-accent" style="margin-right:8px;"></i>Edit Warehouse</div>
        <form method="post" action="/Warehouse/Edit">
            <input type="hidden" name="id" id="editWHId" />
            <div class="form-group mb-3">
                <label class="form-label">NAME *</label>
                <input type="text" name="name" id="editWHName" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label class="form-label">LOCATION</label>
                <input type="text" name="location" id="editWHLocation" class="form-control" />
            </div>
            <div class="form-group mb-4">
                <label class="form-label">MANAGER NAME</label>
                <input type="text" name="managerName" id="editWHManager" class="form-control" />
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save</button>
                <button type="button" class="btn btn-secondary"
                        onclick="document.getElementById('editWHModal').classList.remove('open')">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEditWH(id, name, location, manager) {
            document.getElementById('editWHId').value      = id;
            document.getElementById('editWHName').value    = name;
            document.getElementById('editWHLocation').value= location;
            document.getElementById('editWHManager').value = manager;
            document.getElementById('editWHModal').classList.add('open');
        }
        document.querySelectorAll('.modal-backdrop').forEach(el =>
            el.addEventListener('click', e => { if (e.target === el) el.classList.remove('open'); }));
    </script>
}
