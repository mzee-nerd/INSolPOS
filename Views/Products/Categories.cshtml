@using INSolPOS.Models
@model List<Category>
@{
    ViewBag.Title = "Categories";
    ViewBag.NavContext = "categories";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex gap-2 mb-4">
    <a href="/Products/Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back to Products</a>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start;">
    <div class="card">
        <div class="card-header"><span class="card-title">Product Categories</span></div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>#</th><th>Name</th><th>Products</th></tr></thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="text-muted text-sm">@c.Id</td>
                            <td class="fw-semibold">@c.Name</td>
                            <td><span class="badge badge-accent">@c.Products.Count</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><span class="card-title">Add New Category</span></div>
        <div class="card-body">
            <form method="post" action="/Products/CreateCategory">
                <div class="form-group">
                    <label class="form-label">CATEGORY NAME *</label>
                    <input type="text" name="Name" class="form-control" required placeholder="e.g. Food & Beverages" />
                </div>
                <button type="submit" class="btn btn-primary mt-4"><i class="fas fa-plus"></i> Add Category</button>
            </form>
        </div>
    </div>
</div>
