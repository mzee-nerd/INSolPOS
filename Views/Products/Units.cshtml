@using INSolPOS.Models
@model List<Unit>
@{
    ViewBag.Title = "Units";
    ViewBag.NavContext = "units";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex gap-2 mb-4">
    <a href="/Products/Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back to Products</a>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start;">
    <div class="card">
        <div class="card-header"><span class="card-title">Units of Measurement</span></div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>#</th><th>Name</th><th>Abbreviation</th><th></th></tr></thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="text-muted text-sm">@u.Id</td>
                            <td class="fw-semibold">@u.Name</td>
                            <td><span class="badge badge-info font-mono">@u.Abbreviation</span></td>
                            <td>
                                <button class="btn btn-secondary btn-xs"
                                        onclick="openEditUnit(@u.Id, '@Html.Raw(u.Name.Replace("'","\\\'"))', '@Html.Raw((u.Abbreviation??"").Replace("'","\\\'"))')">
                                    <i class="fas fa-edit"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><span class="card-title">Add New Unit</span></div>
        <div class="card-body">
            <form method="post" action="/Products/CreateUnit">
                <div class="form-group">
                    <label class="form-label">UNIT NAME *</label>
                    <input type="text" name="Name" class="form-control" required placeholder="e.g. Kilogram" />
                </div>
                <div class="form-group">
                    <label class="form-label">ABBREVIATION</label>
                    <input type="text" name="Abbreviation" class="form-control" placeholder="e.g. Kg" />
                </div>
                <button type="submit" class="btn btn-primary mt-4"><i class="fas fa-plus"></i> Add Unit</button>
            </form>
        </div>
    </div>
</div>

<!-- Edit Unit Modal -->
<div class="modal-backdrop" id="editUnitModal">
    <div class="modal">
        <div class="modal-title"><i class="fas fa-edit text-accent" style="margin-right:8px;"></i>Edit Unit</div>
        <form method="post" action="/Products/EditUnit">
            <input type="hidden" name="id" id="editUnitId" />
            <div class="form-group mb-3">
                <label class="form-label">UNIT NAME *</label>
                <input type="text" name="name" id="editUnitName" class="form-control" required />
            </div>
            <div class="form-group mb-4">
                <label class="form-label">ABBREVIATION</label>
                <input type="text" name="abbreviation" id="editUnitAbbr" class="form-control" />
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save</button>
                <button type="button" class="btn btn-secondary"
                        onclick="document.getElementById('editUnitModal').classList.remove('open')">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEditUnit(id, name, abbr) {
            document.getElementById('editUnitId').value   = id;
            document.getElementById('editUnitName').value = name;
            document.getElementById('editUnitAbbr').value = abbr;
            document.getElementById('editUnitModal').classList.add('open');
        }
        document.querySelectorAll('.modal-backdrop').forEach(el =>
            el.addEventListener('click', e => { if (e.target === el) el.classList.remove('open'); }));
    </script>
}
