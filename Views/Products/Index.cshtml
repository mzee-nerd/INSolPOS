@using INSolPOS.Models
@model List<Product>
@{
    ViewBag.Title = "Products";
    ViewBag.NavContext = "products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex justify-between items-center mb-4">
    <div class="flex gap-2">
        <a href="/Products/Categories" class="btn btn-secondary btn-sm"><i class="fas fa-tags"></i> Categories</a>
        <a href="/Products/Units"      class="btn btn-secondary btn-sm"><i class="fas fa-weight"></i> Units</a>
    </div>
    <a href="/Products/Create" class="btn btn-primary"><i class="fas fa-plus"></i> Add Product</a>
</div>

<div class="card">
    <div class="card-header">
        <span class="card-title">Products (@Model.Count)</span>
        <input type="text" id="searchBox" placeholder="Search name / barcode..." class="form-control" style="width:220px;" oninput="filterTable()" />
    </div>
    <div class="table-wrap">
        <table id="prodTable">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    <th class="text-center">Carton Size</th>
                    <th class="text-right">Purchase Price<br/><span style="font-weight:400;font-size:10px;">(per loose unit)</span></th>
                    <th class="text-right">Sale Price<br/><span style="font-weight:400;font-size:10px;">(per loose unit)</span></th>
                    <th class="text-right">Commission%</th>
                    <th class="text-right">Stock (Carton+Loose)</th>
                    <th>Expiry</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var cartonStock = p.CartonQty > 0 ? (int)Math.Floor(p.CurrentStock / p.CartonQty) : 0;
                    var looseStock  = p.CartonQty > 0 ? p.CurrentStock % p.CartonQty : p.CurrentStock;
                    var isLow       = p.CurrentStock <= p.MinStockLevel;
                    var isExpired   = p.ExpiryDate.HasValue && p.ExpiryDate < DateTime.Now;
                    var isExpiring  = p.ExpiryDate.HasValue && p.ExpiryDate < DateTime.Now.AddDays(30) && !isExpired;
                    <tr>
                        <td>
                            <div class="fw-semibold">@p.Name</div>
                            <div class="text-xs text-muted font-mono">@(p.Barcode ?? "—")</div>
                            @if (!string.IsNullOrEmpty(p.BatchNo))
                            { <div class="text-xs text-muted">Batch: @p.BatchNo</div> }
                        </td>
                        <td><span class="badge badge-info">@(p.Category?.Name ?? "—")</span></td>
                        <td class="text-center">
                            <span class="badge badge-accent">@p.CartonQty @(p.Unit?.Abbreviation ?? "pcs")/ctn</span>
                        </td>
                        <td class="text-right">
                            <div class="font-mono text-sm">Rs. @p.PurchasePrice.ToString("N2")</div>
                            <div class="text-xs text-muted">Ctn: Rs. @((p.PurchasePrice * p.CartonQty).ToString("N2"))</div>
                        </td>
                        <td class="text-right">
                            <div class="font-mono fw-semibold text-accent">Rs. @p.SalePrice.ToString("N2")</div>
                            <div class="text-xs text-muted">Ctn: Rs. @((p.SalePrice * p.CartonQty).ToString("N2"))</div>
                        </td>
                        <td class="text-right font-mono" style="color:var(--c-purple);">@p.CommissionPercentage.ToString("N1")%</td>
                        <td class="text-right">
                            <div class="font-mono fw-bold @(p.CurrentStock == 0 ? "text-red" : isLow ? "text-amber" : "text-green")">
                                @cartonStock ctn + @looseStock.ToString("N1") pcs
                            </div>
                            <div class="text-xs text-muted">(@p.CurrentStock.ToString("N2") total)</div>
                        </td>
                        <td class="font-mono text-sm @(isExpired ? "text-red" : isExpiring ? "text-amber" : "text-muted")">
                            @(p.ExpiryDate?.ToString("dd MMM yy") ?? "—")
                        </td>
                        <td>
                            <div class="flex gap-1">
                                <a href="/Products/Edit/@p.Id" class="btn btn-secondary btn-xs" title="Edit"><i class="fas fa-edit"></i></a>
                                <form method="post" action="/Products/Delete/@p.Id" style="display:inline;"
                                      onsubmit="return confirm('Delete \'@p.Name\'?\n\nProducts with sales/purchase history cannot be deleted.')">
                                    <button type="submit" class="btn btn-danger btn-xs" title="Delete"><i class="fas fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function filterTable() {
        const q = document.getElementById('searchBox').value.toLowerCase();
        document.querySelectorAll('#prodTable tbody tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    }
</script>
}
