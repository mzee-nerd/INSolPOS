@{
    ViewBag.Title = "Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
    @{
        var reportLinks = new[] {
            ("/Reports/ProfitLoss", "fa-chart-bar", "Profit & Loss", "var(--c-accent)", "View income vs expenses over any period"),
            ("/Reports/TrialBalance", "fa-balance-scale", "Trial Balance", "var(--c-purple)", "Complete trial balance as of any date"),
            ("/Reports/SalesReport", "fa-file-invoice-dollar", "Sales Report", "var(--c-green)", "Detailed sales with filters by date, customer, staff"),
            ("/Reports/StockReport", "fa-clipboard-list", "Stock Report", "var(--c-cyan)", "Current inventory levels and stock value"),
            ("/Reports/ExpiryReport", "fa-calendar-times", "Expiry Report", "var(--c-red)", "Products expiring soon or already expired"),
            ("/Reports/CommissionReport", "fa-hand-holding-usd", "Commission Report", "var(--c-amber)", "Salesman commissions by period and staff member"),
        };
        foreach (var (url, icon, title, color, desc) in reportLinks)
        {
            <a href="@url" style="text-decoration:none;">
                <div class="card" style="transition:all 0.2s;cursor:pointer;" onmouseover="this.style.borderColor='@color';this.style.transform='translateY(-3px)'" onmouseout="this.style.borderColor='var(--c-border)';this.style.transform=''">
                    <div class="card-body" style="display:flex;align-items:center;gap:16px;padding:20px;">
                        <div style="width:52px;height:52px;border-radius:12px;background:@(color.Replace("var(", "").Replace(")", "")) + '22';background:rgba(79,110,247,0.12);display:flex;align-items:center;justify-content:center;font-size:22px;color:@color;flex-shrink:0;">
                            <i class="fas @icon"></i>
                        </div>
                        <div>
                            <div style="font-size:15px;font-weight:700;color:var(--c-text);margin-bottom:4px;">@title</div>
                            <div style="font-size:12px;color:var(--c-text3);">@desc</div>
                        </div>
                        <i class="fas fa-arrow-right" style="margin-left:auto;color:var(--c-text3);font-size:12px;"></i>
                    </div>
                </div>
            </a>
        }
    }
</div>
