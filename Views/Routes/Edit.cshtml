@using INSolPOS.Models
@model SaleRoute
@{
    ViewBag.Title = "Edit Route";
    ViewBag.NavContext = "routes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="flex gap-2 mb-4">
    <a href="/Routes/Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
</div>
<div class="card" style="max-width:600px;">
    <div class="card-header"><span class="card-title"><i class="fas fa-edit text-accent" style="margin-right:8px;"></i>Edit Route</span></div>
    <div class="card-body">
        <form method="post" action="/Routes/Edit">
            <input type="hidden" name="Id" value="@Model?.Id" />
            <div class="form-group mb-3"><label class="form-label">ROUTE NAME *</label><input type="text" name="Name" class="form-control" value="@Model?.Name" required /></div>
            <div class="form-group mb-3"><label class="form-label">AREA</label><input type="text" name="Area" class="form-control" value="@Model?.Area" /></div>
            <div class="form-group mb-4"><label class="form-label">DESCRIPTION</label><textarea name="Description" class="form-control" rows="2">@Model?.Description</textarea></div>
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Update</button>
                <a href="/Routes/Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
