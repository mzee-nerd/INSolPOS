@using INSolPOS.Models
@model List<ExpenseCategory>
@{
    ViewBag.Title = "Expense Categories";
    ViewBag.NavContext = "expenses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex justify-between items-center mb-4">
    <a href="/Expenses/Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back to Expenses</a>
    <button onclick="document.getElementById('addCatModal').classList.add('open')" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add Category
    </button>
</div>

@if (TempData["Error"] != null)
{   <div class="alert alert-error mb-4"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div> }
@if (TempData["Success"] != null)
{   <div class="alert alert-success mb-4"><i class="fas fa-check-circle"></i> @TempData["Success"]</div> }

<div class="card">
    <div class="card-header">
        <span class="card-title"><i class="fas fa-tags text-red" style="margin-right:8px;"></i>Expense Categories</span>
        <span class="badge badge-info">@Model.Count categories</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>#</th><th>Name</th><th>Description</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var cat in Model)
                {
                    <tr>
                        <td class="text-muted text-sm">@cat.Id</td>
                        <td class="fw-semibold">@cat.Name</td>
                        <td class="text-muted text-sm">@(cat.Description ?? "—")</td>
                        <td>
                            @if (cat.IsActive) { <span class="badge badge-success">Active</span> }
                            else               { <span class="badge">Inactive</span> }
                        </td>
                        <td>
                            <div class="flex gap-1">
                                <button class="btn btn-secondary btn-xs"
                                        onclick="openEdit(@cat.Id, '@Html.Raw(cat.Name.Replace("'","\\\'"))', '@Html.Raw((cat.Description??"").Replace("'","\\\'"))')">
                                    <i class="fas fa-edit"></i>
                                </button>
                                @if (cat.IsActive)
                                {
                                    <form method="post" action="/Expenses/DeleteCategory/@cat.Id" style="display:inline;"
                                          onsubmit="return confirm('Delete category \'@cat.Name\'?')">
                                        <button type="submit" class="btn btn-danger btn-xs btn-icon"><i class="fas fa-trash"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" style="text-align:center;padding:32px;color:var(--c-text3);">No categories yet. Add one above.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Modal -->
<div class="modal-backdrop" id="addCatModal">
    <div class="modal">
        <div class="modal-title"><i class="fas fa-plus text-accent" style="margin-right:8px;"></i>Add Expense Category</div>
        <form method="post" action="/Expenses/CreateCategory">
            <div class="form-group mb-3">
                <label class="form-label">NAME *</label>
                <input type="text" name="Name" class="form-control" required placeholder="e.g. Utilities" autofocus />
            </div>
            <div class="form-group mb-4">
                <label class="form-label">DESCRIPTION</label>
                <input type="text" name="Description" class="form-control" placeholder="Optional" />
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Add</button>
                <button type="button" class="btn btn-secondary"
                        onclick="document.getElementById('addCatModal').classList.remove('open')">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal-backdrop" id="editCatModal">
    <div class="modal">
        <div class="modal-title"><i class="fas fa-edit text-accent" style="margin-right:8px;"></i>Edit Category</div>
        <form method="post" action="/Expenses/EditCategory">
            <input type="hidden" name="id" id="editId" />
            <div class="form-group mb-3">
                <label class="form-label">NAME *</label>
                <input type="text" name="name" id="editName" class="form-control" required />
            </div>
            <div class="form-group mb-4">
                <label class="form-label">DESCRIPTION</label>
                <input type="text" name="description" id="editDesc" class="form-control" />
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save</button>
                <button type="button" class="btn btn-secondary"
                        onclick="document.getElementById('editCatModal').classList.remove('open')">Cancel</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function openEdit(id, name, desc) {
    document.getElementById('editId').value   = id;
    document.getElementById('editName').value = name;
    document.getElementById('editDesc').value = desc;
    document.getElementById('editCatModal').classList.add('open');
}
document.querySelectorAll('.modal-backdrop').forEach(el =>
    el.addEventListener('click', e => { if (e.target === el) el.classList.remove('open'); }));
</script>
}
